# ClauseGuard AI Environment Configuration

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Get one free at https://aistudio.google.com/)
# If left empty, ClauseGuard will automatically run in high-accuracy Local Intelligence Fallback mode.
GEMINI_API_KEY=

# Stripe API Keys (Get from https://dashboard.stripe.com/test/apikeys)
# If left empty, ClauseGuard operates in simulated demo mode.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE_SCAN=
STRIPE_PRICE_MONTHLY_PRO=
